{
  "name": "gnosis-image-search",
  "productName": "Gnosis Images",
  "version": "0.1.1",
  "description": "Museum image search ranked by the PAMELA criterion model",
  "main": "electron/main.js",
  "author": "Hans",
  "repository": "https://github.com/gnosistms/gnosis-image-search",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "build:backend": "bash scripts/build-backend.sh",
    "package:mac": "npm run build:backend && electron-forge package --platform=darwin --arch=arm64",
    "make:mac": "npm run build:backend && electron-forge make --platform=darwin --arch=arm64",
    "publish:mac": "npm run build:backend && electron-forge publish --platform=darwin --arch=arm64",
    "test:model-config": "node --test test/model-config.test.js"
  },
  "engines": {
    "node": ">=22 <24"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-dmg": "^7.8.3",
    "@electron-forge/maker-zip": "^7.8.3",
    "@electron-forge/publisher-github": "^7.8.3",
    "electron": "^43.3.0",
    "png2icons": "^2.0.1"
  }
}
