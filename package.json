{
  "name": "gnosis-image-search",
  "productName": "Gnosis Images",
  "version": "0.1.20",
  "description": "Museum image search ranked by the PAMELA criterion model",
  "main": "electron/main.js",
  "author": "Hans",
  "repository": "https://github.com/gnosistms/gnosis-image-search",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "build:backend": "bash scripts/build-backend.sh",
    "build:backend:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
    "prepare:model": "${BACKEND_PYTHON:-python3} scripts/prepare-bundled-model.py",
    "package:model": "${BACKEND_PYTHON:-python3} scripts/package-model.py",
    "generate:dmg": "${BACKEND_PYTHON:-python3} scripts/generate-dmg-background.py",
    "package:mac": "bash scripts/package-mac.sh package",
    "make:mac": "bash scripts/package-mac.sh make",
    "make:win:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-windows-installer.ps1",
    "make:win": "npm run build:backend:win && npm run make:win:installer",
    "test:electron": "node --test test/*.test.js",
    "test:model-config": "node --test test/model-config.test.js"
  },
  "engines": {
    "node": ">=22 <24"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-dmg": "^7.8.3",
    "@electron-forge/maker-zip": "^7.8.3",
    "@electron-forge/publisher-github": "^7.8.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "png2icons": "^2.0.1"
  }
}
